# Copy to .env.flaremo.local (ignored). Fill locally, never commit credentials.
FLAREMO_URL=https://your-test-instance.example
# Separate opt-in login experiment; origin only, no username/password here:
FLAREMO_AUTH_URL=
FLAREMO_WRITER_PAT=
FLAREMO_READER_PAT=
# Existing synthetic memo for the default read-only probe:
FLAREMO_TEST_MEMO=memos/replace-with-test-resource
# Optional outer Cloudflare Access protection:
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

// Agent Community node on Cloudflare Workers + Durable Objects (RFC 0008,
// runbook: docs/DEPLOY_CLOUDFLARE.zh-CN.md).
//
// The node needs nothing from a FlareMo administrator. Members sign in with a
// personal access token they make themselves, and what the community is doing
// is kept in this object; FlareMo holds only what is its own.
//
// COMMUNITY_OWNER_SUBJECT is the FlareMo resource name (users/...) allowed to
// create the community, and is the one value worth keeping out of this file:
//   npx wrangler@4.129.1 secret put COMMUNITY_OWNER_SUBJECT --config apps/worker/wrangler.jsonc
// Local development passes an --env-file kept outside the repository (scripts/local/worker.mjs).
{
  "name": "agent-network",
  "main": "src/index.js",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "agent-network.zwteam.top", "custom_domain": true }],
  "assets": {
    "directory": "../node/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/a2a/*", "/connector/*", "/agent-onboarding.md", "/agents.md", "/.well-known/*", "/mcp", "/healthz"]
  },
  "durable_objects": {
    "bindings": [{ "name": "COMMUNITY_NODE", "class_name": "CommunityNode" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CommunityNode"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // Matching by meaning; without this binding the node falls back to the
  // keyword baseline (docs/EVAL.zh-CN.md).
  "ai": { "binding": "AI" },
  "vars": {
    "PUBLIC_ORIGIN": "https://agent-network.zwteam.top",
    "FLAREMO_URL": "https://flaremo.kosx.ai"
  },
  "observability": { "enabled": true }
}
